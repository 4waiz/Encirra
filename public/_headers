# Response headers for Cloudflare Workers static assets (copied into dist/ by Vite).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite bundles are content-hashed: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# models and decoder keep stable names: cache for a day
/models/*
  Cache-Control: public, max-age=86400
/draco/*
  Cache-Control: public, max-age=86400
