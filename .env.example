# Encirra environment variables. All are optional — the defaults below are used when unset.
# Copy to .env (git-ignored) or set them in your shell. No paid APIs or cloud credentials are needed.

# Simulation service (npm run dev:sim / scripts/run-sim.mjs)
ENCIRRA_SIM_HOST=127.0.0.1
ENCIRRA_SIM_PORT=8000
# Set to 1 to use a plain venv + pip instead of uv
ENCIRRA_NO_UV=0
# Repository root used by the simulation to locate packages/shared/config/district.json and /scenarios
# (auto-detected from the package location when unset)
ENCIRRA_REPO_ROOT=

# Web app dev/preview server: where Vite proxies /api requests
ENCIRRA_API_URL=http://127.0.0.1:8000

# End-to-end tests (npm run test:e2e): URL of the running web app
ENCIRRA_URL=http://127.0.0.1:5173/

# Asset pipeline (npm run assets:build): Blender executable
BLENDER_EXE="C:\Program Files\Blender Foundation\Blender 5.2\blender.exe"
